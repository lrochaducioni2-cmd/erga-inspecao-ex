# Banco de dados PostgreSQL (local: docker compose up -d; nuvem: Neon/Supabase)
DATABASE_URL="postgresql://inspecao:inspecao@localhost:5433/inspecao?schema=public"

# NextAuth — gere um valor com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-valor-aleatorio-seguro"
NEXTAUTH_URL="http://localhost:3001"

# Código pedido na tela de primeiro acesso (cria o administrador quando o
# banco ainda não tem usuários). Escolha uma palavra só sua.
SETUP_CODE="troque-este-codigo"

# Administrador criado pelo `npm run db:seed` (alternativa local ao primeiro acesso)
ADMIN_NAME="Leandro"
ADMIN_EMAIL="voce@erga.com.br"
ADMIN_PASSWORD="troque-esta-senha"

# Integração com o CRMEx (INTEGRACAO.md) — só por API, nunca banco compartilhado.
# Para desenvolver sem o CRM real: `npm run crm:mock` e use os valores abaixo.
CRM_API_URL="http://localhost:4000"
CRM_API_TOKEN="dev-token"

# Fotos: em produção (Vercel), ligue um Blob store PRIVADO ao projeto — a
# variável BLOB_READ_WRITE_TOKEN é criada automaticamente. Em desenvolvimento,
# sem essa variável, as fotos ficam na pasta abaixo.
# STORAGE_LOCAL_DIR=".data/uploads"
