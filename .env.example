# Banco de dados PostgreSQL (local: docker compose up -d; nuvem: Neon/Supabase)
DATABASE_URL="postgresql://inspecao:inspecao@localhost:5433/inspecao?schema=public"

# NextAuth — gere um valor com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-valor-aleatorio-seguro"
NEXTAUTH_URL="http://localhost:3001"

# Administrador criado pelo `npm run db:seed`
ADMIN_NAME="Leandro"
ADMIN_EMAIL="voce@erga.com.br"
ADMIN_PASSWORD="troque-esta-senha"

# Integração com o CRMEx (INTEGRACAO.md) — só por API, nunca banco compartilhado.
# Para desenvolver sem o CRM real: `npm run crm:mock` e use os valores abaixo.
CRM_API_URL="http://localhost:4000"
CRM_API_TOKEN="dev-token"
