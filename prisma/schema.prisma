// Software de Inspeção Ex — ERGA Engenharia.
// Banco PRÓPRIO: nada é compartilhado com o CRMEx. Dados de cliente vêm da
// API do CRMEx (ver INTEGRACAO.md). O modelo cresce fase a fase (ROTEIRO.md).
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN // administração do sistema (usuários, modelos de documento)
  INSPETOR // coleta em campo e revisão de projetos
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(INSPETOR)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects  Project[]
  equipment Equipment[]
  photos    Photo[]
}

// --- Projetos (Fase 2) ---------------------------------------------------

enum ProjectType {
  INVENTARIO // cadastro rápido Ex / Não Ex + plano de ação
  INSPECAO_EX // checklist ABNT NBR IEC 60079-17
}

enum InspectionGrade {
  VISUAL
  APURADA
  DETALHADA
}

enum ProjectStatus {
  RASCUNHO
  EM_CAMPO
  EM_REVISAO
  APROVADO
  EMITIDO
}

model Project {
  id     String           @id @default(cuid())
  pi     Int              @unique // nº do projeto: base da etiqueta EX-INSP-PI<pi>-0001
  title  String
  type   ProjectType
  grade  InspectionGrade? // só Inspeção Ex
  status ProjectStatus    @default(RASCUNHO)

  // Cliente: vem do CRMEx (crmEmpresaId). Enquanto a API do CRMEx não está
  // ligada, aceita um cliente provisório só com o nome digitado
  // (crmEmpresaId nulo), que depois pode ser vinculado ao CRMEx.
  crmEmpresaId String?
  clientName   String // nome exibido (cópia do CRMEx ou digitado)

  location          String? // local da inspeção
  technicalLead     String? // responsável técnico
  crea              String?
  technicalLeadCert String? // certificado de competência do responsável (ex.: IECEx CoPC)
  proposalNumber    String?
  contractNumber    String?
  notes             String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  areas     Area[]
  equipment Equipment[]
  photos    Photo[]

  @@index([status])
  @@index([crmEmpresaId])
}

// --- Inventário (Fase 3) --------------------------------------------------

enum Zone {
  ZONA_0
  ZONA_1
  ZONA_2
  ZONA_20
  ZONA_21
  ZONA_22
  NAO_CLASSIFICADA
}

// Ambiente / ponto de liberação, definido no estudo de classificação de áreas.
model Area {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  zone      Zone
  notes     String?
  createdAt DateTime @default(now())

  equipment Equipment[]

  @@index([projectId])
}

model Equipment {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  areaId    String
  area      Area    @relation(fields: [areaId], references: [id], onDelete: Cascade)
  item      Int // nº sequencial no projeto → etiqueta EX-INSP-PI<pi>-<item>
  name      String
  isEx      Boolean // Ex certificado → inspeção apurada; Não Ex → substituição
  quantity  Int     @default(1) // itens idênticos representados por esta ficha
  clientTag String? // TAG usada pelo cliente na planta
  notes     String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  photos Photo[]

  @@unique([projectId, item])
  @@index([areaId])
}

enum PhotoKind {
  EQUIPMENT
  LOGO // logo do cliente no relatório (uma por projeto)
}

// Arquivo guardado no armazenamento (Vercel Blob privado em produção,
// pasta local em desenvolvimento — ver src/lib/storage.ts). O arquivo só é
// servido por /api/fotos/:id, para usuários logados.
model Photo {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  kind        PhotoKind  @default(EQUIPMENT)
  storageKey  String     @unique
  contentType String
  size        Int
  width       Int?
  height      Int?
  caption     String?

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([projectId, kind])
  @@index([equipmentId])
}
